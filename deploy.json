{
  "schema_version": 1,
  "id": "git-support",
  "name": "Git Support",
  "image": "ghcr.io/alexisshvili24-lgtm/codex.lesson06/git-support",
  "runtime": "service",
  "container_port": 8025,
  "health": {
    "type": "http",
    "path": "/health",
    "timeout_seconds": 45
  },
  "resources": {
    "memory_mib": 256,
    "cpus": 0.5,
    "pids": 64
  },
  "storage": {
    "persistent": true,
    "container_path": "/app/data"
  },
  "network": {
    "needs_outbound": true,
    "proxy_compatible": true
  }
}
